{
  "uid":"pawprint-application","title":"PawPrint Application Health","description":"PetClinic and Reporting availability, readiness, restarts and Replica-backed Reporting freshness.","schemaVersion":42,"version":2,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"HTTP availability","gridPos":{"x":0,"y":0,"w":8,"h":4},"targets":[{"expr":"probe_success{job=\"pawprint-http\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]},"mappings":[{"type":"value","options":{"0":{"text":"DOWN"},"1":{"text":"UP"}}}]}}},
    {"id":2,"type":"stat","title":"Observed HTTP status","gridPos":{"x":8,"y":0,"w":8,"h":4},"targets":[{"expr":"probe_http_status_code{job=\"pawprint-http\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":200},{"color":"yellow","value":300},{"color":"orange","value":400},{"color":"red","value":500}]}}}},
    {"id":3,"type":"stat","title":"Reporting state","gridPos":{"x":16,"y":0,"w":8,"h":4},"targets":[{"expr":"pawprint_reporting_stale","legendFormat":"stale"},{"expr":"pawprint_reporting_degraded","legendFormat":"degraded"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"red","value":1}]},"mappings":[{"type":"value","options":{"0":{"text":"healthy"},"1":{"text":"unhealthy"}}}]}}},
    {"id":4,"type":"timeseries","title":"Synthetic Ingress latency","description":"Blackbox latency through the actual NGINX route.","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"probe_duration_seconds{job=\"pawprint-http\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}},
    {"id":5,"type":"timeseries","title":"Reporting replication signals","description":"WAL message age proves receiver communication; replay pending bytes measures unapplied WAL. Idle replay timestamps are not treated as failure.","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"time()-pawprint_reporting_last_wal_message_timestamp_seconds","legendFormat":"WAL message age"},{"expr":"pawprint_reporting_replay_pending_bytes","legendFormat":"replay pending bytes"}]},
    {"id":6,"type":"stat","title":"Application Pod readiness","gridPos":{"x":0,"y":12,"w":12,"h":5},"targets":[{"expr":"max by(pod)(kube_pod_status_ready{namespace=\"pawprint\",condition=\"true\",pod=~\"petclinic-[a-z0-9]+-[a-z0-9]+|reporting-[a-z0-9]+-[a-z0-9]+\"})","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":7,"type":"stat","title":"Current application restart count","gridPos":{"x":12,"y":12,"w":6,"h":5},"targets":[{"expr":"sum by(pod)(kube_pod_container_status_restarts_total{namespace=\"pawprint\",pod=~\"petclinic-[a-z0-9]+-[a-z0-9]+|reporting-[a-z0-9]+-[a-z0-9]+\"})","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"decimals":0,"unit":"short"}}},
    {"id":8,"type":"stat","title":"Restart increase (1h)","gridPos":{"x":18,"y":12,"w":6,"h":5},"targets":[{"expr":"sum by(pod)(increase(kube_pod_container_status_restarts_total{namespace=\"pawprint\",pod=~\"petclinic-[a-z0-9]+-[a-z0-9]+|reporting-[a-z0-9]+-[a-z0-9]+\"}[1h]))","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"decimals":0,"unit":"short","thresholds":{"steps":[{"color":"green","value":null},{"color":"orange","value":1},{"color":"red","value":3}]}}}}
  ]
}
