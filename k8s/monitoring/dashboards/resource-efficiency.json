{
  "uid":"pawprint-resource-efficiency","title":"PawPrint Kubernetes Resource Efficiency","description":"Actual CPU/memory versus requests and limits, saturation, throttling and OOM evidence.","schemaVersion":42,"version":1,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"timeseries","title":"Node CPU utilization","gridPos":{"x":0,"y":0,"w":12,"h":7},"targets":[{"expr":"100*(1-avg by(node)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":2,"type":"timeseries","title":"Node memory utilization","gridPos":{"x":12,"y":0,"w":12,"h":7},"targets":[{"expr":"100*(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":3,"type":"bargauge","title":"CPU actual / request","gridPos":{"x":0,"y":7,"w":8,"h":7},"targets":[{"expr":"100*sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"pawprint\",container!=\"\",image!=\"\"}[5m]))/clamp_min(sum by(pod)(kube_pod_container_resource_requests{namespace=\"pawprint\",resource=\"cpu\"}),0.001)","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0}}},
    {"id":4,"type":"bargauge","title":"Memory actual / request","gridPos":{"x":8,"y":7,"w":8,"h":7},"targets":[{"expr":"100*sum by(pod)(container_memory_working_set_bytes{namespace=\"pawprint\",container!=\"\",image!=\"\"})/clamp_min(sum by(pod)(kube_pod_container_resource_requests{namespace=\"pawprint\",resource=\"memory\"}),1)","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0}}},
    {"id":5,"type":"bargauge","title":"Memory actual / limit","gridPos":{"x":16,"y":7,"w":8,"h":7},"targets":[{"expr":"100*sum by(pod)(container_memory_working_set_bytes{namespace=\"pawprint\",container!=\"\",image!=\"\"})/clamp_min(sum by(pod)(kube_pod_container_resource_limits{namespace=\"pawprint\",resource=\"memory\"}),1)","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}]}}}},
    {"id":6,"type":"bargauge","title":"CPU throttling","gridPos":{"x":0,"y":14,"w":8,"h":7},"targets":[{"expr":"100*sum by(pod)(rate(container_cpu_cfs_throttled_periods_total{namespace=\"pawprint\",container!=\"\"}[5m]))/clamp_min(sum by(pod)(rate(container_cpu_cfs_periods_total{namespace=\"pawprint\",container!=\"\"}[5m])),0.000001)","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":7,"type":"bargauge","title":"Top 5 CPU Pods","gridPos":{"x":8,"y":14,"w":8,"h":7},"targets":[{"expr":"topk(5,sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"pawprint\",container!=\"\",image!=\"\"}[5m])))","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"cores"}}},
    {"id":8,"type":"bargauge","title":"Top 5 memory Pods","gridPos":{"x":16,"y":14,"w":8,"h":7},"targets":[{"expr":"topk(5,sum by(pod)(container_memory_working_set_bytes{namespace=\"pawprint\",container!=\"\",image!=\"\"}))","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":9,"type":"stat","title":"OOMKilled containers","gridPos":{"x":0,"y":21,"w":6,"h":4},"targets":[{"expr":"sum(kube_pod_container_status_last_terminated_reason{namespace=\"pawprint\",reason=\"OOMKilled\"} == 1) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"red","value":1}]}}}},
    {"id":10,"type":"stat","title":"Node memory saturation","gridPos":{"x":6,"y":21,"w":18,"h":4},"targets":[{"expr":"100*(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":80},{"color":"red","value":90}]}}}}
  ]
}
