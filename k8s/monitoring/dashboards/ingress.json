{
  "uid":"pawprint-ingress","title":"PawPrint Ingress and Network","description":"Separates synthetic Blackbox latency/status from controller-wide NGINX request metrics. Per-route status-class and upstream latency metrics are not exported by the current NGINX Inc. configuration.","schemaVersion":42,"version":3,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Controller target","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"up{job=\"nginx-ingress\"}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":2,"type":"stat","title":"NGINX reload status","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"nginx_ingress_controller_nginx_last_reload_status"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":3,"type":"stat","title":"Application routes","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"probe_success{job=\"pawprint-http\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":4,"type":"stat","title":"Monitoring routes","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"probe_success{job=\"monitoring-ingress\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":5,"type":"timeseries","title":"Synthetic route latency","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"probe_duration_seconds{job=~\"pawprint-http|monitoring-ingress\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}},
    {"id":6,"type":"timeseries","title":"Observed status by individual route","description":"Expected statuses: applications 200, Grafana 200/302, unauthenticated Prometheus and Alertmanager 401.","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"probe_http_status_code{job=~\"pawprint-http|monitoring-ingress\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":200},{"color":"yellow","value":300},{"color":"orange","value":400},{"color":"red","value":500}]}}}},
    {"id":7,"type":"timeseries","title":"Controller-wide NGINX request rate","gridPos":{"x":0,"y":12,"w":12,"h":8},"targets":[{"expr":"rate(nginx_ingress_nginx_http_requests_total[5m])","legendFormat":"all Ingress requests/s"}],"fieldConfig":{"defaults":{"unit":"reqps","min":0}}},
    {"id":8,"type":"stat","title":"Synthetic 4xx / 5xx routes now","gridPos":{"x":12,"y":12,"w":12,"h":4},"targets":[{"expr":"sum(probe_http_status_code{job=~\"pawprint-http|monitoring-ingress\"} >= bool 400 and probe_http_status_code{job=~\"pawprint-http|monitoring-ingress\"} < bool 500)","legendFormat":"4xx routes"},{"expr":"sum(probe_http_status_code{job=~\"pawprint-http|monitoring-ingress\"} >= bool 500)","legendFormat":"5xx routes"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":9,"type":"timeseries","title":"Synthetic latency percentiles (15m)","gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"expr":"quantile_over_time(0.50,probe_duration_seconds{job=\"pawprint-http\"}[15m])","legendFormat":"{{app}} p50"},{"expr":"quantile_over_time(0.95,probe_duration_seconds{job=\"pawprint-http\"}[15m])","legendFormat":"{{app}} p95"},{"expr":"quantile_over_time(0.99,probe_duration_seconds{job=\"pawprint-http\"}[15m])","legendFormat":"{{app}} p99"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}},
    {"id":10,"type":"stat","title":"Active NGINX connections","gridPos":{"x":0,"y":20,"w":12,"h":4},"targets":[{"expr":"nginx_ingress_nginx_connections_active"}],"fieldConfig":{"defaults":{"decimals":0}}}
  ]
}
