{
  "uid":"pawprint-storage","title":"PawPrint Storage and Persistence","description":"Actual local-path directory usage is collected read-only on each worker. Requested capacity is a scheduling budget, not an enforced quota; backing filesystem availability is shown separately.","schemaVersion":42,"version":3,"refresh":"30s","time":{"from":"now-12h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"PVC phase","gridPos":{"x":0,"y":0,"w":8,"h":4},"targets":[{"expr":"kube_persistentvolumeclaim_status_phase{namespace=\"pawprint\",phase=~\"Bound|Pending|Lost\"} == 1","legendFormat":"{{persistentvolumeclaim}} {{phase}}"}]},
    {"id":2,"type":"stat","title":"Requested capacity (not usage)","gridPos":{"x":8,"y":0,"w":8,"h":4},"targets":[{"expr":"kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=\"pawprint\"}","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":3,"type":"stat","title":"Local-path provisioner Ready","gridPos":{"x":16,"y":0,"w":8,"h":4},"targets":[{"expr":"sum(kube_pod_status_ready{namespace=\"local-path-storage\",condition=\"true\"})"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":4,"type":"bargauge","title":"Actual directory usage by PVC","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"pawprint_pvc_directory_used_bytes","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0}}},
    {"id":5,"type":"bargauge","title":"Usage / requested capacity","description":"Local-path does not enforce requested capacity; this ratio is a budget signal, not filesystem fullness.","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"100*pawprint_pvc_directory_used_bytes / on(namespace,persistentvolumeclaim) kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=\"pawprint\"}","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":70},{"color":"orange","value":85},{"color":"red","value":100}]}}}},
    {"id":6,"type":"timeseries","title":"Primary and Replica actual usage","gridPos":{"x":0,"y":12,"w":12,"h":7},"targets":[{"expr":"pawprint_pvc_directory_used_bytes{persistentvolumeclaim=~\"data-postgres-primary-0|data-postgres-replica-0\"}","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":7,"type":"timeseries","title":"Backup, Prometheus and Grafana actual usage","gridPos":{"x":12,"y":12,"w":12,"h":7},"targets":[{"expr":"pawprint_pvc_directory_used_bytes{persistentvolumeclaim=~\"petclinic-backups|prometheus-data|grafana-data\"}","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":8,"type":"stat","title":"Backing filesystem available (not PVC available)","gridPos":{"x":0,"y":19,"w":8,"h":5},"targets":[{"expr":"min by(node)(pawprint_pvc_backing_filesystem_available_bytes)","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"bytes","thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":10737418240},{"color":"green","value":21474836480}]}}}},
    {"id":9,"type":"table","title":"PV / PVC / node-local binding","description":"Only the actionable mapping and measured used bytes are retained; local-path data cannot move transparently to another node.","gridPos":{"x":8,"y":19,"w":16,"h":5},"targets":[{"expr":"max by(persistentvolume,persistentvolumeclaim,node) ((kube_persistentvolume_info{storageclass=\"standard\"} * on(persistentvolume) group_left(namespace,persistentvolumeclaim) label_replace(kube_persistentvolumeclaim_info{namespace=\"pawprint\"}, \"persistentvolume\", \"$1\", \"volumename\", \"(.*)\")) * on(namespace,persistentvolumeclaim) group_left(node) pawprint_pvc_directory_used_bytes)","format":"table","instant":true}],"fieldConfig":{"defaults":{"unit":"bytes"}}}
  ]
}
