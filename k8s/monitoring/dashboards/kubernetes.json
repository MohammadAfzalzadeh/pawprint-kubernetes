{
  "uid":"pawprint-kubernetes","title":"PawPrint Kubernetes Cluster","description":"Node, workload and Pod health with integer restarts, top consumers, throttling and requests versus actual usage.","schemaVersion":42,"version":3,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Node Ready","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"kube_node_status_condition{condition=\"Ready\",status=\"true\"}","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":2,"type":"stat","title":"Pods by phase","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"sum by(phase)(kube_pod_status_phase{namespace=\"pawprint\"})","legendFormat":"{{phase}}"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":3,"type":"stat","title":"Current restarts by Pod","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"sum by(pod)(kube_pod_container_status_restarts_total{namespace=\"pawprint\"})","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"decimals":0,"unit":"short"}}},
    {"id":4,"type":"stat","title":"Restart increase by Pod (1h)","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"round(sum by(pod)(increase(kube_pod_container_status_restarts_total{namespace=\"pawprint\"}[1h])))","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"decimals":0,"unit":"short"}}},
    {"id":5,"type":"timeseries","title":"Node CPU utilization","gridPos":{"x":0,"y":4,"w":12,"h":7},"targets":[{"expr":"100*(1-avg by(node)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":6,"type":"timeseries","title":"Node memory utilization","gridPos":{"x":12,"y":4,"w":12,"h":7},"targets":[{"expr":"100*(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id":7,"type":"bargauge","title":"Top 5 CPU-consuming Pods","gridPos":{"x":0,"y":11,"w":8,"h":7},"targets":[{"expr":"topk(5,sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"pawprint\",container!=\"\",image!=\"\"}[5m])))","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"cores","min":0}}},
    {"id":8,"type":"bargauge","title":"Top 5 memory-consuming Pods","gridPos":{"x":8,"y":11,"w":8,"h":7},"targets":[{"expr":"topk(5,sum by(pod)(container_memory_working_set_bytes{namespace=\"pawprint\",container!=\"\",image!=\"\"}))","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0}}},
    {"id":9,"type":"bargauge","title":"CPU throttling by Pod","gridPos":{"x":16,"y":11,"w":8,"h":7},"targets":[{"expr":"100*sum by(pod)(rate(container_cpu_cfs_throttled_periods_total{namespace=\"pawprint\",container!=\"\"}[5m]))/clamp_min(sum by(pod)(rate(container_cpu_cfs_periods_total{namespace=\"pawprint\",container!=\"\"}[5m])),0.000001)","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":10},{"color":"red","value":25}]}}}},
    {"id":10,"type":"timeseries","title":"Pod CPU actual versus requests","gridPos":{"x":0,"y":18,"w":12,"h":8},"targets":[{"expr":"sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"pawprint\",container!=\"\",image!=\"\"}[5m]))","legendFormat":"{{pod}} actual"},{"expr":"sum by(pod)(kube_pod_container_resource_requests{namespace=\"pawprint\",resource=\"cpu\"})","legendFormat":"{{pod}} request"}],"fieldConfig":{"defaults":{"unit":"cores","min":0}}},
    {"id":11,"type":"timeseries","title":"Pod memory actual versus requests","gridPos":{"x":12,"y":18,"w":12,"h":8},"targets":[{"expr":"sum by(pod)(container_memory_working_set_bytes{namespace=\"pawprint\",container!=\"\",image!=\"\"})","legendFormat":"{{pod}} actual"},{"expr":"sum by(pod)(kube_pod_container_resource_requests{namespace=\"pawprint\",resource=\"memory\"})","legendFormat":"{{pod}} request"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0}}},
    {"id":12,"type":"stat","title":"OOMKilled containers","gridPos":{"x":0,"y":26,"w":6,"h":4},"targets":[{"expr":"sum(kube_pod_container_status_last_terminated_reason{namespace=\"pawprint\",reason=\"OOMKilled\"} == 1) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"red","value":1}]}}}},
    {"id":13,"type":"bargauge","title":"Deployment availability","gridPos":{"x":6,"y":26,"w":18,"h":4},"targets":[{"expr":"100*kube_deployment_status_replicas_available{namespace=\"pawprint\"}/clamp_min(kube_deployment_spec_replicas{namespace=\"pawprint\"},1)","legendFormat":"{{deployment}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":80},{"color":"green","value":100}]}}}}
  ]
}
