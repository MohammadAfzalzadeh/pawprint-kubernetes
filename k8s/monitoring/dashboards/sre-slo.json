{
  "uid":"pawprint-sre-slo","title":"PawPrint SRE and SLO","description":"Blackbox-based service-level view. Demo SLO: each public application route returns HTTP 200 for 99.5% of 30 days; this dashboard shows 24h/7d evidence and 7d budget until 30d retention exists.","schemaVersion":42,"version":1,"refresh":"30s","time":{"from":"now-24h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Availability now","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"probe_success{job=\"pawprint-http\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1,"thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":0.99},{"color":"green","value":0.995}]}}}},
    {"id":2,"type":"stat","title":"Availability over 24h","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"100*avg_over_time(probe_success{job=\"pawprint-http\"}[24h])","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":99},{"color":"green","value":99.5}]}}}},
    {"id":3,"type":"stat","title":"Availability over 7d","description":"Uses all retained samples until seven full days have accumulated.","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"100*avg_over_time(probe_success{job=\"pawprint-http\"}[7d])","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":99},{"color":"green","value":99.5}]}}}},
    {"id":4,"type":"stat","title":"7d error budget remaining","description":"SLO target 99.5%; 0 means the 0.5% error budget is exhausted.","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"clamp_min(clamp_max(100*(0.005-(1-avg_over_time(probe_success{job=\"pawprint-http\"}[7d])))/0.005,100),0)","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"red","value":null},{"color":"yellow","value":25},{"color":"green","value":50}]}}}},
    {"id":5,"type":"timeseries","title":"Synthetic error rate (non-200)","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"100*(1-avg_over_time(probe_success{job=\"pawprint-http\"}[5m]))","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0}}},
    {"id":6,"type":"timeseries","title":"Synthetic 5xx rate","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"100*avg_over_time((probe_http_status_code{job=\"pawprint-http\"} >= bool 500)[5m:15s])","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0}}},
    {"id":7,"type":"timeseries","title":"Synthetic latency P50 / P95 / P99","description":"Percentiles over Blackbox probe samples, not server-side request histograms.","gridPos":{"x":0,"y":12,"w":24,"h":8},"targets":[{"expr":"quantile_over_time(0.50,probe_duration_seconds{job=\"pawprint-http\"}[15m])","legendFormat":"{{app}} p50"},{"expr":"quantile_over_time(0.95,probe_duration_seconds{job=\"pawprint-http\"}[15m])","legendFormat":"{{app}} p95"},{"expr":"quantile_over_time(0.99,probe_duration_seconds{job=\"pawprint-http\"}[15m])","legendFormat":"{{app}} p99"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}}
  ]
}
