{
  "uid":"pawprint-postgresql","title":"PawPrint PostgreSQL High Availability","description":"Role correctness, connection states, WAL receiver connectivity and idle-safe replication lag semantics.","schemaVersion":42,"version":3,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Database availability","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"pg_up","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":2,"type":"stat","title":"Replica in recovery","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"pawprint_postgres_role_is_in_recovery{job=\"postgres-replica\"}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":3,"type":"stat","title":"WAL receiver streaming","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"pawprint_replication_streaming{job=\"postgres-replica\"}"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":4,"type":"stat","title":"Replay pending bytes","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"pawprint_replication_lag_bytes{job=\"postgres-replica\"}"}],"fieldConfig":{"defaults":{"unit":"bytes","thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":8388608},{"color":"red","value":16777216}]}}}},
    {"id":5,"type":"timeseries","title":"Connections by role and state","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"sum by(role,state)(pg_stat_activity_count{datname=\"petclinic\",state=~\"active|idle|idle in transaction|idle in transaction [(]aborted[)]\"})","legendFormat":"{{role}} {{state}}"}],"fieldConfig":{"defaults":{"decimals":0,"unit":"short"}}},
    {"id":6,"type":"timeseries","title":"Commit and rollback rate","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"sum by(role)(rate(pg_stat_database_xact_commit{datname=\"petclinic\"}[5m]))","legendFormat":"{{role}} commits/s"},{"expr":"sum by(role)(rate(pg_stat_database_xact_rollback{datname=\"petclinic\"}[5m]))","legendFormat":"{{role}} rollbacks/s"}],"fieldConfig":{"defaults":{"unit":"ops","min":0}}},
    {"id":7,"type":"timeseries","title":"Replication lag bytes and WAL message age","description":"Message age measures receiver connectivity. Replay transaction age is shown separately and can grow while idle.","gridPos":{"x":0,"y":12,"w":12,"h":8},"targets":[{"expr":"pawprint_replication_lag_bytes{job=\"postgres-replica\"}","legendFormat":"pending bytes"},{"expr":"pawprint_replication_last_message_age_seconds{job=\"postgres-replica\"}","legendFormat":"last WAL receipt age (seconds)"}]},
    {"id":8,"type":"timeseries","title":"Last WAL receipt vs last transaction replay age","gridPos":{"x":12,"y":12,"w":12,"h":8},"targets":[{"expr":"pawprint_replication_last_message_age_seconds{job=\"postgres-replica\"}","legendFormat":"WAL receipt age"},{"expr":"pawprint_replication_replay_age_seconds{job=\"postgres-replica\"}","legendFormat":"transaction replay age (idle-safe)"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}},
    {"id":9,"type":"timeseries","title":"WAL generation, receive and replay rate","gridPos":{"x":0,"y":20,"w":12,"h":8},"targets":[{"expr":"clamp_min(rate(pawprint_replication_received_lsn_bytes{job=\"postgres-primary\"}[5m]),0)","legendFormat":"primary generated"},{"expr":"clamp_min(rate(pawprint_replication_received_lsn_bytes{job=\"postgres-replica\"}[5m]),0)","legendFormat":"replica received"},{"expr":"clamp_min(rate(pawprint_replication_replayed_lsn_bytes{job=\"postgres-replica\"}[5m]),0)","legendFormat":"replica replayed"}],"fieldConfig":{"defaults":{"unit":"Bps","min":0}}},
    {"id":10,"type":"timeseries","title":"Cache hit ratio","gridPos":{"x":12,"y":20,"w":12,"h":8},"targets":[{"expr":"sum by(role)(pg_stat_database_blks_hit{datname=\"petclinic\"})/clamp_min(sum by(role)(pg_stat_database_blks_hit{datname=\"petclinic\"}+pg_stat_database_blks_read{datname=\"petclinic\"}),1)","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}}}
  ]
}
