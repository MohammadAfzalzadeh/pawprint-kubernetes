{
  "uid":"pawprint-backup","title":"PawPrint Backup and Recovery","description":"Separates Job completion, archive SHA256 integrity and restore verification. Backup schedule is every 6h, RPO alert threshold is 7h, restore verification objective is 7d.","schemaVersion":42,"version":2,"refresh":"30s","time":{"from":"now-7d","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Latest archive timestamp","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"pawprint_backup_latest_timestamp_seconds"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"}}},
    {"id":2,"type":"stat","title":"Latest archive age (RPO 7h)","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"time()-pawprint_backup_latest_timestamp_seconds"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":21600},{"color":"red","value":25200}]}}}},
    {"id":3,"type":"stat","title":"Archive integrity verified","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"pawprint_backup_archive_integrity"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]},"mappings":[{"type":"value","options":{"0":{"text":"FAILED"},"1":{"text":"VERIFIED"}}}]}}},
    {"id":4,"type":"stat","title":"Verified archive files","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"pawprint_backup_verified_files"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":5,"type":"stat","title":"Latest successful Backup Job","gridPos":{"x":0,"y":4,"w":6,"h":4},"targets":[{"expr":"pawprint_backup_job_last_success_timestamp_seconds"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"}}},
    {"id":6,"type":"stat","title":"Next scheduled backup","gridPos":{"x":6,"y":4,"w":6,"h":4},"targets":[{"expr":"kube_cronjob_next_schedule_time{namespace=\"pawprint\",cronjob=\"petclinic-backup\"}-time()"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":0},{"color":"yellow","value":21600}]}}}},
    {"id":7,"type":"stat","title":"Latest restore result","gridPos":{"x":12,"y":4,"w":6,"h":4},"targets":[{"expr":"pawprint_restore_verification_success"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]},"mappings":[{"type":"value","options":{"0":{"text":"FAILED/MISSING"},"1":{"text":"SUCCEEDED"}}}]}}},
    {"id":8,"type":"stat","title":"Restore verification age (objective 7d)","gridPos":{"x":18,"y":4,"w":6,"h":4},"targets":[{"expr":"time()-pawprint_restore_verification_timestamp_seconds"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":518400},{"color":"red","value":604800}]}}}},
    {"id":9,"type":"table","title":"Latest archive identity","gridPos":{"x":0,"y":8,"w":12,"h":5},"targets":[{"expr":"pawprint_backup_latest_info","format":"table","instant":true}]},
    {"id":10,"type":"table","title":"Latest restore identity and retained result","gridPos":{"x":12,"y":8,"w":12,"h":5},"targets":[{"expr":"pawprint_restore_verification_info","format":"table","instant":true}]},
    {"id":11,"type":"stat","title":"Backup Jobs active / failed","gridPos":{"x":0,"y":13,"w":8,"h":4},"targets":[{"expr":"pawprint_backup_active_jobs","legendFormat":"active"},{"expr":"pawprint_backup_failed_jobs","legendFormat":"failed"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":12,"type":"timeseries","title":"Backup age trend","gridPos":{"x":8,"y":13,"w":16,"h":7},"targets":[{"expr":"time()-pawprint_backup_latest_timestamp_seconds","legendFormat":"archive age"}],"fieldConfig":{"defaults":{"unit":"s"}}}
  ]
}
