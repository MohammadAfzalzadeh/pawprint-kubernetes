{"uid":"pawprint-overview","title":"PawPrint Overview","description":"Overall PawPrint application, cluster, database, ingress, storage and backup health.","schemaVersion":42,"version":1,"refresh":"15s","time":{"from":"now-6h","to":"now"},"panels":[{"id":1,"type":"stat","title":"Application availability","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"probe_success{job=\"pawprint-http\"}","legendFormat":"{{app}}"}],"fieldConfig":{"defaults":{"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]},"mappings":[{"type":"value","options":{"0":{"text":"DOWN"},"1":{"text":"UP"}}}]}}},{"id":2,"type":"stat","title":"Ready nodes","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})"}]},{"id":3,"type":"stat","title":"PostgreSQL roles and stream","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"pg_up","legendFormat":"{{role}} up"},{"expr":"pawprint_replication_streaming{job=\"postgres-replica\"}","legendFormat":"replica streaming"}]},{"id":4,"type":"stat","title":"PVCs Bound","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(kube_persistentvolumeclaim_status_phase{namespace=\"pawprint\",phase=\"Bound\"})"}]},{"id":5,"type":"stat","title":"Reporting fresh","gridPos":{"x":0,"y":4,"w":6,"h":4},"targets":[{"expr":"1-pawprint_reporting_stale"}]},{"id":6,"type":"stat","title":"Ingress routes","gridPos":{"x":6,"y":4,"w":6,"h":4},"targets":[{"expr":"probe_success{job=~\"pawprint-http|monitoring-ingress\"}","legendFormat":"{{app}}"}]},{"id":7,"type":"stat","title":"Latest backup age","gridPos":{"x":12,"y":4,"w":6,"h":4},"targets":[{"expr":"time()-pawprint_backup_latest_timestamp_seconds"}],"fieldConfig":{"defaults":{"unit":"s"}}},{"id":8,"type":"stat","title":"Firing alerts","gridPos":{"x":18,"y":4,"w":6,"h":4},"targets":[{"expr":"count(ALERTS{alertstate=\"firing\"}) or vector(0)"}]}]}
