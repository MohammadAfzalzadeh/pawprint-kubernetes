{
  "uid":"pawprint-postgresql-performance","title":"PawPrint PostgreSQL Performance","description":"Least-privilege pg_monitor performance view for PetClinic Primary and Replica.","schemaVersion":42,"version":1,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Active queries","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"sum by(role)(pg_stat_activity_count{datname=\"petclinic\",state=\"active\"})","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":2,"type":"stat","title":"Longest active transaction","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"max by(role)(pg_stat_activity_max_tx_duration{datname=\"petclinic\",state=\"active\"})","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":3},{"color":"red","value":30}]}}}},
    {"id":3,"type":"stat","title":"Connection saturation","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"100*sum by(role)(pg_stat_activity_count{datname=\"petclinic\"})/on(role) max by(role)(pg_settings_max_connections)","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":85}]}}}},
    {"id":4,"type":"stat","title":"Active lock waits","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(pg_stat_activity_count{datname=\"petclinic\",state=\"active\",wait_event_type=\"Lock\"}) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"red","value":1}]}}}},
    {"id":5,"type":"timeseries","title":"Transactions per second","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"sum by(role)(rate(pg_stat_database_xact_commit{datname=\"petclinic\"}[5m]))","legendFormat":"{{role}} commits/s"},{"expr":"sum by(role)(rate(pg_stat_database_xact_rollback{datname=\"petclinic\"}[5m]))","legendFormat":"{{role}} rollbacks/s"}]},
    {"id":6,"type":"timeseries","title":"Locks by role and mode","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"sum by(role,mode)(pg_locks_count{datname=\"petclinic\"})","legendFormat":"{{role}} {{mode}}"}]},
    {"id":7,"type":"timeseries","title":"Database size and growth","gridPos":{"x":0,"y":12,"w":12,"h":8},"targets":[{"expr":"pg_database_size_bytes{datname=\"petclinic\"}","legendFormat":"{{role}} size"},{"expr":"clamp_min(deriv(pg_database_size_bytes{datname=\"petclinic\"}[1h]),0)","legendFormat":"{{role}} growth B/s"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":8,"type":"timeseries","title":"Cache hit ratio","gridPos":{"x":12,"y":12,"w":12,"h":8},"targets":[{"expr":"sum by(role)(pg_stat_database_blks_hit{datname=\"petclinic\"})/clamp_min(sum by(role)(pg_stat_database_blks_hit{datname=\"petclinic\"}+pg_stat_database_blks_read{datname=\"petclinic\"}),1)","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}}},
    {"id":9,"type":"timeseries","title":"Deadlocks (increase)","gridPos":{"x":0,"y":20,"w":8,"h":7},"targets":[{"expr":"sum by(role)(increase(pg_stat_database_deadlocks{datname=\"petclinic\"}[1h]))","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":10,"type":"timeseries","title":"Checkpoint / restartpoint rate","gridPos":{"x":8,"y":20,"w":8,"h":7},"targets":[{"expr":"sum by(role)(rate(pawprint_checkpointer_num_timed[5m])+rate(pawprint_checkpointer_num_requested[5m])+rate(pawprint_checkpointer_restartpoints_done[5m]))","legendFormat":"{{role}}"}],"fieldConfig":{"defaults":{"unit":"ops"}}},
    {"id":11,"type":"timeseries","title":"WAL generation / receive / replay","gridPos":{"x":16,"y":20,"w":8,"h":7},"targets":[{"expr":"clamp_min(rate(pawprint_replication_received_lsn_bytes{job=\"postgres-primary\"}[5m]),0)","legendFormat":"generated"},{"expr":"clamp_min(rate(pawprint_replication_received_lsn_bytes{job=\"postgres-replica\"}[5m]),0)","legendFormat":"received"},{"expr":"clamp_min(rate(pawprint_replication_replayed_lsn_bytes{job=\"postgres-replica\"}[5m]),0)","legendFormat":"replayed"}],"fieldConfig":{"defaults":{"unit":"Bps","min":0}}}
  ]
}
