{
  "uid":"pawprint-alerts-incidents","title":"PawPrint Alerts and Incidents","description":"Current Prometheus alerts, severity, duration and recent alert activity. Prometheus does not provide a durable incident database; resolved history is limited to retained ALERTS_FOR_STATE samples.","schemaVersion":42,"version":1,"refresh":"15s","time":{"from":"now-24h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Firing alerts","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"count(ALERTS{alertstate=\"firing\"}) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":3}]}}}},
    {"id":2,"type":"stat","title":"Critical alerts","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"red","value":1}]}}}},
    {"id":3,"type":"stat","title":"Warning alerts","gridPos":{"x":12,"y":0,"w":6,"h":4},"targets":[{"expr":"count(ALERTS{alertstate=\"firing\",severity=\"warning\"}) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":1}]}}}},
    {"id":4,"type":"stat","title":"Alert notifications received (24h)","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(increase(alertmanager_alerts_received_total[24h])) or vector(0)"}],"fieldConfig":{"defaults":{"decimals":0}}},
    {"id":5,"type":"table","title":"Pending / firing alert details","description":"Shows active alert labels; a single unlabeled zero means that no alert is currently pending or firing.","gridPos":{"x":0,"y":4,"w":16,"h":9},"targets":[{"expr":"ALERTS or on() vector(0)","format":"table","instant":true}]},
    {"id":6,"type":"bargauge","title":"Current pending / firing duration","description":"ALERTS_FOR_STATE stores the Unix timestamp at which the current pending or firing state began; it does not carry an alertstate label.","gridPos":{"x":16,"y":4,"w":8,"h":9},"targets":[{"expr":"time()-ALERTS_FOR_STATE","legendFormat":"{{alertname}}"}],"fieldConfig":{"defaults":{"unit":"s","min":0}}},
    {"id":7,"type":"timeseries","title":"Alert state transitions / resolved evidence (24h)","description":"Changes in retained ALERTS_FOR_STATE series; this is evidence of transitions, not a durable incident count.","gridPos":{"x":0,"y":13,"w":16,"h":7},"targets":[{"expr":"sum by(alertname)(changes(ALERTS_FOR_STATE[24h]))","legendFormat":"{{alertname}} transitions"}]},
    {"id":8,"type":"text","title":"Runbook dashboards","gridPos":{"x":16,"y":13,"w":8,"h":7},"options":{"mode":"markdown","content":"[Overview](/d/pawprint-overview)  \n[Kubernetes](/d/pawprint-kubernetes)  \n[PostgreSQL HA](/d/pawprint-postgresql)  \n[PostgreSQL Performance](/d/pawprint-postgresql-performance)  \n[Application](/d/pawprint-application)  \n[Storage](/d/pawprint-storage)  \n[Backup](/d/pawprint-backup)"}}
  ]
}
